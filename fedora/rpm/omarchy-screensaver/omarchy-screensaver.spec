# Omarchy Quattro - omarchy-screensaver (native Wayland screensaver)
# Upstream: https://github.com/omacom/omarchy-screensaver (Rust, MIT, v1.3.1)
# A wlr-layer-shell overlay on every display that animates the Omarchy branding
# text with ttfx; any key press, click, scroll or pointer move dismisses it.
#
# Upstream (both omarchy-pkgs and the README) installs the binary OFF PATH at
# /usr/lib/omarchy-screensaver/omarchy-screensaver, and Omarchy's
# omarchy-launch-screensaver execs exactly that path.
%global debug_package %{nil}
%global _lto_cflags %{nil}

Name:           omarchy-screensaver
Version:        1.3.1
Release:        1%{?dist}
Summary:        Native Wayland screensaver for Omarchy

License:        MIT
URL:            https://github.com/omacom/omarchy-screensaver
Source0:        %{url}/archive/refs/tags/v%{version}.tar.gz
# Vendored crate deps -- including the ttfx git dependency -- generated by
# fedora/rpm/vendor-rust.sh so the build works offline in COPR/mock.
Source1:        %{name}-%{version}-vendor.tar.xz

BuildRequires:  rust-packaging
BuildRequires:  rust >= 1.85
BuildRequires:  cargo
BuildRequires:  pkgconfig(wayland-client)
BuildRequires:  pkgconfig(xkbcommon)

# fc-match locates the monospace font used to render the branding text.
Requires:       fontconfig

%description
The Omarchy screensaver: a native Wayland overlay on every display that
animates your branding text with ttfx effects. It reads
~/.config/omarchy/branding/screensaver.txt, falling back to the bundled sample,
and exits on any keyboard, pointer or scroll input.

%prep
%autosetup
tar xf %{SOURCE1}

%build
export CARGO_TARGET_DIR=target
cargo build --release --offline --locked

%install
# Upstream's name for the built binary is omarchy-launch-screensaver; Omarchy
# invokes it as /usr/lib/omarchy-screensaver/omarchy-screensaver.
install -Dm755 target/release/omarchy-launch-screensaver \
  %{buildroot}%{_libexecdir}/omarchy-screensaver/omarchy-screensaver

%files
%license LICENSE
%doc README.md
%{_libexecdir}/omarchy-screensaver/omarchy-screensaver

